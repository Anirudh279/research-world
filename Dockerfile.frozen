FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
WORKDIR /worker
COPY LICENSE /worker/LICENSE
COPY src/web_research_sim/core.py src/web_research_sim/frozen_worker.py /worker/web_research_sim/
RUN touch /worker/web_research_sim/__init__.py && useradd --uid 10001 --no-create-home frozen
ENV PYTHONPATH=/worker PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "web_research_sim.frozen_worker"]
